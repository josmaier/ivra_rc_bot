# Copy this file to .env and fill in the values

# Bot token and application (client) ID from the Discord developer portal
TOKEN=
CLIENT_ID=
# ID of the Discord server the commands get registered in
GUILD_ID=

# Channel IDs
RACE_CONTROL_CHANNEL_ID=
BF_CLEAR_CHANNEL_ID=
TOW_CHANNEL_ID=
PROTEST_CHANNEL_ID=
SERVED_CHANNEL_ID=
# Channel the bot posts the changelog to when it starts
RESTART_CHANNEL_ID=

# Default link for /sheet (can be changed later with /set-sheet)
SHEET_URL=
